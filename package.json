{
  "name": "pt-rcm",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Outpatient PT billing rules prototype. Synthetic data, fixture clearinghouse, no live claims.",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "setup:cloud": "bash scripts/cloud-setup.sh",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm --filter @pt-rcm/web dev",
    "db:generate": "pnpm --filter @pt-rcm/db generate",
    "db:migrate": "pnpm --filter @pt-rcm/db migrate",
    "db:seed": "pnpm --filter @pt-rcm/db seed",
    "demo": "pnpm --filter @pt-rcm/web exec node --import tsx ../../scripts/demo.ts",
    "seed:demo": "pnpm --filter @pt-rcm/web seed:demo"
  }
}
